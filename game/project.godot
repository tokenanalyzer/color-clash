; Engine configuration file.
; Color Clash production project foundation.

config_version=5

[application]

config/name="War of Love"
config/description="Jamie's journey to rescue Jasmine from Jinn across five kingdoms — a fantasy adventure match-3."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4")
config/icon="res://icon.png"
run/max_fps=60
boot_splash/bg_color=Color(0.02, 0.03, 0.07, 1)
boot_splash/show_image=false

[autoload]

SaveService="*res://scripts/save/save_service.gd"
GameData="*res://scripts/core/game_data.gd"
AudioSettings="*res://scripts/audio/audio_settings.gd"
Economy="*res://scripts/economy/economy_service.gd"
Boosters="*res://scripts/economy/booster_inventory.gd"
Progress="*res://scripts/economy/progress_service.gd"
Inventory="*res://scripts/economy/inventory_service.gd"
Audio="*res://scripts/audio/audio_hooks.gd"
Music="*res://scripts/audio/music_director.gd"
Iap="*res://scripts/services/iap_service.gd"
Ads="*res://scripts/services/ads_service.gd"
Firebase="*res://scripts/services/firebase_service.gd"
Assets="*res://scripts/core/asset_library.gd"
GameEvents="*res://scripts/core/game_event_bus.gd"
CharacterDirector="*res://scripts/character/character_director.gd"
Story="*res://scripts/story/story_director.gd"

[display]

[display/window]

size/viewport_width=1080
size/viewport_height=1920
size/window_width_override=540
size/window_height_override=960
size/resizable=false
stretch/mode="canvas_items"
stretch/aspect="expand"
; 1 = Portrait (Godot 4 enum: Landscape=0, Portrait=1, ...). A string here
; is silently ignored and the engine falls back to Landscape.
handheld/orientation=1

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194309,"unicode":13)]
}

[importer_defaults]

; Premium art pass: every PNG under assets/ imports LOSSLESS (no VRAM block
; compression -> no banding/blur on the baked jewels, gradients and UI), with
; mipmaps so the board gems stay crisp when scaled down to cell size, and an
; alpha-border fix so bilinear filtering never pulls a dark halo out of a
; transparent edge. icon.png keeps its own .import (created earlier).
texture={
"compress/mode": 0,
"compress/high_quality": false,
"compress/hdr_compression": 1,
"compress/normal_map": 0,
"compress/channel_pack": 0,
"mipmaps/generate": true,
"mipmaps/limit": -1,
"roughness/mode": 0,
"process/fix_alpha_border": true,
"process/premult_alpha": false,
"process/normal_map_invert_y": false,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/size_limit": 0,
"detect_3d/compress_to": 0
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.07, 1)
